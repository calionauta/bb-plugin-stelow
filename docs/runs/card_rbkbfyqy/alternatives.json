  "tradeoffs": [
    {
      "alternativeId": "A-sibling-line",
      "benefit": "Most findable: a labelled line in the same band as the flow strip, at a fixed height, with nothing shared.",
      "cost": "Adds a third stacked band above the kanban, on a board whose vertical budget is already spent."
    },
    {
      "alternativeId": "B-segment-in-flow-strip",
      "benefit": "Zero added height and one toggle for both readings.",
      "cost": "Couples releases to finished cards: inherits the count===0 early return, needs that guard changed, and puts two recencies in one row."
    },
    {
      "alternativeId": "C-control-strip-chip",
      "benefit": "No band, no height, minimal visual weight.",
      "cost": "Least discoverable entry; an unlabelled chip reads as a filter, and a reader may never open it."
    },
    {
      "alternativeId": "D-hybrid-chip-with-own-drawer",
      "benefit": "Keeps the chip's zero height and the sibling line's independence, and carries the release itself in the label so the chip is not a mystery.",
      "cost": "Splits the board's attention between the control strip and the metrics band; the chip must stay a full touch target."
    }
  ],
  "verdict": "ready"
