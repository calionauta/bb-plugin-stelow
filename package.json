{
  "name": "bb-plugin-stelow",
  "version": "0.1.41",
  "type": "module",
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Stelow",
    "description": "Visualize and control Stelow workflows, reviews, gates, scopes, and tasks.",
    "branding": {
      "icon": "Star"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills/"
    ]
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "^0.4.22",
    "@radix-ui/react-dialog": "^1.1.19",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build && node scripts/postbuild.mjs",
    "reload": "bb plugin reload stelow",
    "build:reload": "npm run build && npm run reload",
    "test": "npm run test:artifacts && npm run test:inbox && npm run test:ask-cancel && npm run test:promote && npm run test:research && npm run test:worker-ledger && npm run test:workflow-lineage && npm run test:skills-sync && npm run test:skills-verify",
    "test:artifacts": "node tests/artifact-manifest.test.mjs",
    "test:ask-cancel": "node tests/ask-cancel.test.mjs",
    "test:promote": "node tests/promote-card.test.mjs",
    "test:research": "node tests/research-brief.test.mjs && node tests/research-strategies.test.mjs && node tests/card-move.test.mjs && node tests/artifact-groups.test.mjs",
    "test:worker-ledger": "node tests/worker-ledger.test.mjs",
    "test:workflow-lineage": "node tests/workflow-lineage.test.mjs",
    "test:skills-sync": "node tests/workflow-skills-sync.test.mjs",
    "test:skills-verify": "node tests/skills-sync-verify.test.mjs",
    "test:inbox": "node tests/inbox-flows.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "data",
    "references",
    "scripts/postbuild.mjs",
    "server.ts",
    "app.tsx",
    "components.json"
  ]
}
