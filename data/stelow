#!/usr/bin/env bash
# scripts/stelow — SCOPE-2 helper (status / advance / doctor).
#
# Passive: reads/writes the project state.md under the current git root.
# Idempotent on bad input (never mutates on invalid candidate). Fail-closed.
# No npm deps — POSIX sh + node only.
#
# Usage:
#   scripts/stelow status [--json]
#   scripts/stelow advance <candidate>
#   scripts/stelow doctor [--json]
#   scripts/stelow --help

set -euo pipefail

PROG="${0##*/}"
# Project workflows derive their root from Git. Exploratory workspaces are not
# repositories, so the plugin provides an explicit per-workflow state directory.
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$ROOT" ]; then
  if [ -n "${STELOW_STATEDIR:-}" ]; then
    # Per-workflow state dir is <root>/.stelow/<date>/<dirHash>, so the project
    # root is three levels up. Project checkouts keep using `git rev-parse`.
    ROOT="$(cd "$STELOW_STATEDIR/../../.." && pwd)"
  else
    echo "$PROG: not in a git repo (set STELOW_STATEDIR for an exploratory workspace)" >&2
    exit 2
  fi
fi
# State is PER-WORKFLOW: each card owns a dir .stelow/<date>/<dirHash> holding
# its own state.md, invariants.json, and lock. The server sets STELOW_STATEDIR
# to that workflow dir. When unset (manual/legacy CLI use from repo root), fall
# back to the old single root state.md + .stelow/invariants.json.
STATEDIR="${STELOW_STATEDIR:-$ROOT/.stelow}"
STATE="${STELOW_STATE:-$STATEDIR/state.md}"
INVARIANTS="$STATEDIR/invariants.json"
TRANSITIONS="${STELOW_TRANSITIONS:-$ROOT/skills/stelow-workflow-orchestrator/references/transitions.md}"
LOCKDIR="$STATEDIR/lock"
LOCK_TTL_SEC="${STELOW_LOCK_TTL_SEC:-120}"

mkdir -p "$STATEDIR"

# --- shared helpers ---------------------------------------------------------

die() { echo "$PROG: $*" >&2; exit 1; }

yaml_get() {
  local key="$1" file="$2"
  [ -f "$file" ] || return 1
  python3 - "$file" "$key" <<'PY'
import sys, re
path, key = sys.argv[1], sys.argv[2]
text = open(path).read()
m = re.match(r"^---\n(.*?)\n---", text, re.DOTALL)
if not m: sys.exit(1)
# First pass: top-level scalar match.
for line in m.group(1).splitlines():
    mm = re.match(r"^" + re.escape(key) + r":\s*(.*)$", line)
    if mm: print(mm.group(1).strip()); sys.exit(0)
# Second pass: one-level-nested scalar under any "config:" / "stages:" block.
# Walk lines, track nesting depth of any block the key could live under.
in_block = None
for line in m.group(1).splitlines():
    if re.match(r"^[A-Za-z_][\w-]*:\s*$", line):
        in_block = line.rstrip(":").strip()
        continue
    if in_block == "config":
        mm = re.match(r"^  " + re.escape(key) + r":\s*(.*)$", line)
        if mm: print(mm.group(1).strip()); sys.exit(0)
sys.exit(1)
PY
}

status_text() {
  local name intent stage status appetite review_mode
  name=$(yaml_get name "$STATE" 2>/dev/null || echo "?")
  intent=$(yaml_get intent "$STATE" 2>/dev/null || echo "?")
  stage=$(yaml_get current_stage "$STATE" 2>/dev/null || echo "?")
  status=$(yaml_get status "$STATE" 2>/dev/null || echo "?")
  appetite=$(yaml_get appetite "$STATE" 2>/dev/null || echo "?")
  review_mode=$(yaml_get review_mode "$STATE" 2>/dev/null || echo "?")
  cat <<EOF
workflow : $name
intent   : $intent
stage    : $stage
status   : $status
appetite : $appetite
review   : $review_mode
lock     : $(lock_state)
EOF
}

status_json() {
  python3 - "$STATE" "$INVARIANTS" <<'PY'
import json, os, sys, re
state, inv = sys.argv[1:3]
out = {"workflow": None, "intent": None, "current_stage": None, "status": None, "config": {}}
def get_top(blob, key):
    m = re.match(r"^---\n(.*?)\n---", blob, re.DOTALL)
    if not m: return None
    for line in m.group(1).splitlines():
        mm = re.match(r"^" + re.escape(key) + r":\s*(.*)$", line)
        if mm: return mm.group(1).strip()
    return None
def get_nested(blob, parent, key):
    m = re.match(r"^---\n(.*?)\n---", blob, re.DOTALL)
    if not m: return None
    in_block = False
    for line in m.group(1).splitlines():
        if re.match(r"^" + re.escape(parent) + r":\s*$", line):
            in_block = True; continue
        if in_block:
            mm = re.match(r"^  " + re.escape(key) + r":\s*(.*)$", line)
            if mm: return mm.group(1).strip()
            # leaving the block (a new top-level key)
            if re.match(r"^[A-Za-z_][\w-]*:\s*(.*)$", line) and not line.startswith(" "):
                in_block = False
    return None
if os.path.exists(state):
    blob = open(state).read()
    for k in ("name", "intent", "current_stage", "status"):
        out[k.replace("name", "workflow") if k == "name" else k] = get_top(blob, k)
    cfg = {}
    for k in ("appetite", "review_mode", "product_type"):
        v = get_nested(blob, "config", k)
        if v is not None: cfg[k] = v
    out["config"] = cfg
if os.path.exists(inv):
    try: out["invariants"] = json.loads(open(inv).read())
    except Exception: out["invariants_error"] = "parse-failed"
print(json.dumps(out, indent=2, sort_keys=True))
PY
}

# --- lock (mkdir, TTL) -------------------------------------------------------

# Portable directory mtime (seconds) for the lock TTL. Unlike `date`/`stat`,
# python3's st_mtime is identical on GNU/Linux and BSD/macOS (the script
# already requires python3 for YAML parsing). Falls back to "now" (no
# staleness) on error.
lock_mtime() {
  python3 -c 'import os, sys; print(int(os.stat(sys.argv[1]).st_mtime))' "$LOCKDIR" 2>/dev/null || echo "$(date +%s)"
}

lock_state() {
  if [ -d "$LOCKDIR" ]; then
    local now mtime age
    now=$(date +%s)
    mtime=$(lock_mtime)
    age=$((now - mtime))
    if [ "$age" -gt "$LOCK_TTL_SEC" ]; then
      echo "stale (age=${age}s > ttl=${LOCK_TTL_SEC}s)"
    else
      local pid host
      pid=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "?")
      host=$(cat "$LOCKDIR/host" 2>/dev/null || echo "?")
      echo "held (pid=$pid host=$host age=${age}s)"
    fi
  else
    echo "free"
  fi
}

lock_acquire() {
  if mkdir "$LOCKDIR" 2>/dev/null; then
    echo "$$" > "$LOCKDIR/pid"
    hostname > "$LOCKDIR/host"
    date -Iseconds > "$LOCKDIR/acquired"
    trap 'rm -rf "$LOCKDIR" 2>/dev/null || true' EXIT
    return 0
  fi
  local now mtime age pid host
  now=$(date +%s)
  mtime=$(lock_mtime)
  age=$((now - mtime))
  if [ "$age" -gt "$LOCK_TTL_SEC" ]; then
    echo "$PROG: stale lock (age=${age}s) — removing" >&2
    rm -rf "$LOCKDIR" || die "lock remove failed"
    if mkdir "$LOCKDIR" 2>/dev/null; then
      echo "$$" > "$LOCKDIR/pid"; hostname > "$LOCKDIR/host"; date -Iseconds > "$LOCKDIR/acquired"
      trap 'rm -rf "$LOCKDIR" 2>/dev/null || true' EXIT
      return 0
    fi
  fi
  pid=$(cat "$LOCKDIR/pid" 2>/dev/null || echo "?")
  host=$(cat "$LOCKDIR/host" 2>/dev/null || echo "?")
  die "lock held by pid=$pid host=$host (age=${age}s; set STELOW_LOCK_TTL_SEC to override)"
}

# --- advance -----------------------------------------------------------------

allowed_candidates_for_stage() {
  local stage="$1" intent="$2"
  [ -f "$TRANSITIONS" ] || die "transitions reference not found at $TRANSITIONS"
  python3 - "$stage" "$intent" "$TRANSITIONS" <<'PY'
import sys, re
stage, intent, path = sys.argv[1:4]
text = open(path).read()
m = re.search(r"^### " + re.escape(stage) + r"\s*\n(.*?)(?=^### |\Z)", text, re.MULTILINE | re.DOTALL)
if not m: sys.exit(1)
allowed = []
for line in m.group(1).splitlines():
    mm = re.match(r"^(next|accept|reject|rework|annotate):\s*(.*)$", line.strip())
    if not mm: continue
    # Trailing "(...)" segments are human comments ("(none — stays at triage)",
    # "shape (shape rework — same stage)"), not stages. Strip them before
    # tokenizing so comment words never leak into the allowed list.
    value = re.sub(r"\(.*", "", mm.group(2))
    for token in re.split(r"[,\s]+", value):
        token = token.strip("[]\"'")
        if token and re.match(r"^[a-z][a-z0-9-]*$", token): allowed.append(token)
route = re.search(r"^\*\*" + re.escape(intent) + r":\*\*\s*(.+)$", text, re.MULTILINE)
if route:
    stages = [part.strip() for part in route.group(1).split("→")]
    if stage in stages and stages.index(stage) + 1 < len(stages): allowed.append(stages[stages.index(stage) + 1])
for candidate in dict.fromkeys(allowed): print(candidate)
PY
}

all_stages() {
  python3 - "$TRANSITIONS" <<'PY'
import sys, re
text = open(sys.argv[1]).read()
for m in re.finditer(r"^### (\S+)\s*$", text, re.MULTILINE):
    print(m.group(1))
PY
}

do_advance() {
  local candidate="$1"
  [ -n "$candidate" ] || die "advance requires a <candidate> argument"
  [ -f "$STATE" ] || die "state.md not found at $STATE (run /stelow entry first)"
  local current
  current=$(yaml_get current_stage "$STATE" 2>/dev/null) || die "state.md has no current_stage (run /stelow entry first)"
  local intent allowed
  intent=$(yaml_get intent "$STATE" 2>/dev/null || echo "unknown")
  allowed=$(allowed_candidates_for_stage "$current" "$intent") || die "no transition defined from stage '$current'"
  echo "$allowed" | grep -qx "$candidate" ||
    die "invalid transition '$current' -> '$candidate' (allowed: $(echo "$allowed" | paste -sd, -))"

  # pre-condition: required artifacts
  python3 - "$current" "$ROOT" "$STATEDIR" "${STELOW_TRANSITIONS:-}" <<'PY' || die "pre-condition check failed"
import sys, re, os, glob
current, root, statedir, trans_override = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
trans = trans_override if trans_override else os.path.join(root, "skills/stelow-workflow-orchestrator/references/transitions.md")
trans = open(trans).read()
m = re.search(r"^### " + re.escape(current) + r"\s*\n(.*?)(?=^### |\Z)", trans, re.MULTILINE | re.DOTALL)
if not m: sys.exit(0)
for line in m.group(1).splitlines():
    am = re.match(r"^artifact:\s*(\S+)\s*$", line.strip())
    if am:
        pat = am.group(1)
        # Resolve the glob relative to the workflow's own state dir first
        # (.stelow/<date>/<dirHash>), then fall back to the repo root.
        bases = [statedir, root]
        if pat.startswith("/"): bases = [""]
        matched = False
        for base in bases:
            fullpat = pat if base == "" else os.path.join(base, pat)
            if glob.glob(fullpat):
                matched = True
                break
        if not matched:
            print(f"missing required artifact: {pat} (expected under {statedir})", file=sys.stderr); sys.exit(1)
PY

  lock_acquire

  # Mutate state.md and record every new Markdown file as produced by the
  # source stage. A list preserves multiple outputs from the same stage.
  python3 - "$candidate" "$current" "$ROOT" "$STATEDIR" "$STATE" <<'PY'
import sys, re, os, glob, datetime
candidate, current, root, statedir, path = sys.argv[1:6]
blob = open(path).read()
m = re.match(r"^(---\n)(.*?)(\n---)(.*)$", blob, re.DOTALL)
if not m:
    print("state.md: missing YAML frontmatter", file=sys.stderr); sys.exit(2)
header_open, fm, header_close, body = m.group(1), m.group(2), m.group(3), m.group(4)
artifacts = []
block = re.search(r"^artifacts:\s*\n(.*?)(?=^\S|\Z)", fm, re.MULTILINE | re.DOTALL)
if block:
    entry = {}
    for line in block.group(1).splitlines():
        start = re.match(r"^  - ([a-z_]+):\s*(.+)$", line)
        field = re.match(r"^    ([a-z_]+):\s*(.+)$", line)
        if start:
            if entry: artifacts.append(entry)
            entry = {start.group(1): start.group(2).strip()}
        elif field and entry:
            entry[field.group(1)] = field.group(2).strip()
    if entry: artifacts.append(entry)
known_paths = {entry.get("path") for entry in artifacts}
timestamp = datetime.datetime.now(datetime.timezone.utc).isoformat()
for walk_root, _, filenames in os.walk(statedir):
    for filename in filenames:
        if not filename.endswith(".md") or filename == "state.md": continue
        full = os.path.join(walk_root, filename)
        relative = os.path.relpath(full, root).replace(os.sep, "/")
        if relative in known_paths: continue
        label = os.path.splitext(filename)[0].replace("_", " ").replace("-", " ").strip()
        artifacts.append({"stage": current, "kind": "document", "label": label, "path": relative, "generated_at": timestamp})
        known_paths.add(relative)

out = []
in_artifacts = False
cur_found = False
for line in fm.splitlines():
    if line == "artifacts:" or re.match(r"^artifacts:\s*.*$", line):
        in_artifacts = True
        continue
    if in_artifacts:
        if line.startswith(" ") or line == "":
            continue
        in_artifacts = False
    mm = re.match(r"^current_stage:\s*(.*)$", line)
    if mm:
        out.append(f"current_stage: {candidate}"); cur_found = True
        continue
    out.append(line)
if not cur_found:
    out.append(f"current_stage: {candidate}")
out.append("artifacts:")
for entry in artifacts:
    out.extend([f"  - stage: {entry['stage']}", f"    kind: {entry.get('kind', 'document')}", f"    label: {entry.get('label', os.path.basename(entry['path']))}", f"    path: {entry['path']}", f"    generated_at: {entry.get('generated_at', timestamp)}"])

new_blob = header_open + "\n".join(out) + header_close + body
open(path, "w").write(new_blob)
PY

  # append invariants
  python3 - "$candidate" "$INVARIANTS" <<'PY'
import sys, os, json, datetime
candidate, inv_path = sys.argv[1], sys.argv[2]
os.makedirs(os.path.dirname(inv_path), exist_ok=True)
data = {}
if os.path.exists(inv_path):
    try: data = json.loads(open(inv_path).read())
    except Exception: data = {}
data.setdefault("history", [])
data["history"].append({"stage": candidate,
                         "at": datetime.datetime.now(datetime.timezone.utc).isoformat()})
data["current_stage"] = candidate
open(inv_path, "w").write(json.dumps(data, indent=2, sort_keys=True) + "\n")
PY

  rm -rf "$LOCKDIR"
  echo "$PROG: advanced to $candidate"
}

# --- doctor ------------------------------------------------------------------

do_doctor() {
  python3 - "$ROOT" "$LOCKDIR" "$LOCK_TTL_SEC" "$STATE" "$TRANSITIONS" "${1:-}" <<'PY'
import sys, os, json, re, time
root, lockdir, ttl, state_path, trans_path, want_json = sys.argv[1:7]
findings = []
def add(severity, klass, msg):
    findings.append({"severity": severity, "class": klass, "message": msg})

# 1. orphan dir
if os.path.isdir(lockdir):
    age = int(time.time() - os.stat(lockdir).st_mtime)
    if age > int(ttl):
        add("warn", "stale-lock", f".stelow/lock is stale (age={age}s > ttl={ttl}s)")

# 2. missing dir (intent convention)
if os.path.exists(state_path):
    blob = open(state_path).read()
    mm = re.search(r"^intent:\s*(\S+)", blob, re.MULTILINE)
    if mm:
        intent = mm.group(1).strip()
        if intent not in ("new-product", "feature", "bugfix", "refactor", "investigate"):
            add("warn", "missing-dir", f"state.md intent '{intent}' has no artifacts dir convention")

# 3. parallel lock (live pid)
if os.path.isdir(lockdir):
    pidfile = os.path.join(lockdir, "pid")
    if os.path.exists(pidfile):
        try:
            pid = int(open(pidfile).read().strip())
            os.kill(pid, 0)
            add("info", "parallel-lock", f"another live process holds the lock (pid={pid})")
        except (ValueError, ProcessLookupError, PermissionError):
            add("warn", "orphan-pid", "lock pid file points at dead pid")

# 4. state<->transitions drift
if os.path.exists(state_path) and os.path.exists(trans_path):
    blob = open(state_path).read()
    cm = re.search(r"^current_stage:\s*(\S+)", blob, re.MULTILINE)
    if cm:
        cur = cm.group(1).strip()
        text = open(trans_path).read()
        if not re.search(r"^### " + re.escape(cur) + r"\s*$", text, re.MULTILINE):
            add("error", "state-transitions-drift",
                f"state.md current_stage '{cur}' not in transitions.md")

if want_json == "--json":
    print(json.dumps({"findings": findings,
                       "ok": not any(f["severity"] == "error" for f in findings)},
                      indent=2, sort_keys=True))
    if any(f["severity"] == "error" for f in findings):
        sys.exit(1)
else:
    if not findings:
        print("doctor: ok (no drift)")
    for f in findings:
        print(f"{f['severity']:5} {f['class']:24} {f['message']}")
    if any(f["severity"] == "error" for f in findings):
        sys.exit(1)
PY
}

# --- dispatch ----------------------------------------------------------------

usage() {
  cat <<EOF
$PROG — SCOPE-2 helper (status / advance / doctor)

Usage:
  $PROG status [--json]
  $PROG advance <candidate>
  $PROG doctor [--json]
  $PROG --help

State file:  $STATE
Transitions: $TRANSITIONS
Lock dir:    $LOCKDIR (TTL ${LOCK_TTL_SEC}s, override with STELOW_LOCK_TTL_SEC)
EOF
}

case "${1:-}" in
  status)
    shift
    case "${1:-}" in
      --json) status_json ;;
      "")     status_text ;;
      *) die "status: unknown arg '$1'" ;;
    esac
    ;;
  advance)
    shift
    candidate="${1:-}"; [ -n "$candidate" ] || die "advance requires <candidate>"
    do_advance "$candidate"
    ;;
  doctor)
    shift
    do_doctor "${1:-}"
    ;;
  -h|--help|help|"") usage ;;
  *) die "unknown subcommand '$1' (try --help)" ;;
esac
